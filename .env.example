# Copy this file to .env and fill it in. Enable exactly one block below.
# Never commit .env (it is git-ignored). .env.example is the committed template.
#
# DATABASE_URL      SQLAlchemy URL for the warehouse. Use a READ-ONLY credential.
#                   For Databricks it is built from the DATABRICKS_* values below.
# DATABASE_SCHEMAS  Comma-separated schemas to expose (tables shown as schema.table).
#                   Leave unset to use the connection's default schema.
# SEMANTIC_DIR      Semantic layer directory for this dataset (local Markdown files).

# --- Local demo (read-only SQLite). Build first: sqlite3 demo/demo.db < demo/seed.sql
DATABASE_URL=sqlite:///file:demo/demo.db?mode=ro&uri=true
SEMANTIC_DIR=semantic/demo

# --- Harbourstone Financial on Databricks (needs: uv sync --extra databricks)
# DATABRICKS_HOST       workspace hostname, no https:// (e.g. dbc-1234abcd-5678.cloud.databricks.com)
# DATABRICKS_HTTP_PATH  SQL warehouse > Connection details > HTTP path (e.g. /sql/1.0/warehouses/abc123)
# DATABRICKS_CATALOG    Unity Catalog catalog that holds the Harbourstone schemas
# DATABRICKS_TOKEN      access token for a read-only service principal (or your PAT for the PoC)
# DATABRICKS_HOST=<host>
# DATABRICKS_HTTP_PATH=<http-path>
# DATABRICKS_CATALOG=harbourstone
# DATABRICKS_TOKEN=<token>
# DATABASE_URL=databricks://token:${DATABRICKS_TOKEN}@${DATABRICKS_HOST}?http_path=${DATABRICKS_HTTP_PATH}&catalog=${DATABRICKS_CATALOG}&schema=retail_banking
# DATABASE_SCHEMAS=retail_banking,commercial_banking,insurance
# SEMANTIC_DIR=semantic/harbourstone_financial

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Maximum rows returned by run_query.
# MAX_ROWS=100

# Maximum characters returned by run_query.
# MAX_RESULT_CHARS=20000
