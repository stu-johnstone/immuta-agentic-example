# Copy this file to .env (git-ignored) and fill it in. Never commit .env.

# ---------------------------------------------------------------------------
# DATABASE_URL: SQLAlchemy URL for the warehouse. Use a READ-ONLY credential.
# ---------------------------------------------------------------------------

# Local demo (read-only SQLite). Build it first: sqlite3 demo/demo.db < demo/seed.sql
DATABASE_URL=sqlite:///file:demo/demo.db?mode=ro&uri=true

# Databricks (needs: uv sync --extra databricks). Comment out the SQLite line above and fill in:
#   <token>      access token for a read-only service principal (or your PAT for the PoC)
#   <host>       workspace hostname, e.g. dbc-1234abcd-5678.cloud.databricks.com
#   <http-path>  SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/abcdef1234567890
#   <catalog>    Unity Catalog catalog
#   <schema>     schema to query
# DATABASE_URL=databricks://token:<token>@<host>?http_path=<http-path>&catalog=<catalog>&schema=<schema>

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Schema to introspect, if not set by the URL.
# DATABASE_SCHEMA=

# Maximum rows returned by run_query.
# MAX_ROWS=100

# Maximum characters returned by run_query.
# MAX_RESULT_CHARS=20000
